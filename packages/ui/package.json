{
  "name": "@soe/ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@hookform/resolvers": "7.0.6",
    "@lucasmarkes/hairline": "0.5.1",
    "@shadcn/react": "0.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.72.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.8.1",
    "react": "19.2.8",
    "react-day-picker": "10.0.2",
    "react-dom": "19.2.8",
    "react-hook-form": "7.92.0",
    "react-resizable-panels": "4.22.1",
    "recharts": "3.8.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "vaul": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@soe/typescript-config": "workspace:*",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./motion.css": "./src/styles/motion.css",
    "./primitives/*": {
      "types": "./dist/primitives/*.d.ts",
      "import": "./dist/primitives/*.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "import": "./dist/hooks/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js"
    },
    "./book-runtime": {
      "types": "./dist/illustrations/book/book-runtime.d.ts",
      "import": "./dist/illustrations/book/book-runtime.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-book.mjs && node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test:browser": "playwright test --config playwright.config.ts"
  },
  "imports": {
    "#ui/*": "./src/primitives/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts",
    "#components/*": "./src/components/*.tsx"
  }
}
