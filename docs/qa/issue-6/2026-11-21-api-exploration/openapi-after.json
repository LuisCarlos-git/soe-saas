                      "TUTOR",
                      "TEACHER",
                      "MONITOR"
                    ]
                  }
                }
              },
              "required": ["organizationId", "name", "roles"],
              "additionalProperties": false
            }
          }
        },
        "required": ["memberships"],
        "additionalProperties": false
      },
      "MfaStatusResponse": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "verified": {
            "type": "boolean"
          }
        },
        "required": ["enabled", "verified"],
        "additionalProperties": false
      },
      "IdentityResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          }
        },
        "required": ["id", "name", "email"],
        "additionalProperties": false
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": ["email", "password"],
        "additionalProperties": false
      },
      "MfaEnrollmentRequest": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": ["password"],
        "additionalProperties": false
      },
      "MfaVerificationRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$"
          }
        },
        "required": ["code"],
        "additionalProperties": false
      },
      "MfaSetupResponse": {
        "type": "object",
        "properties": {
          "totpURI": {
            "type": "string",
            "format": "starts_with",
            "pattern": "^otpauth:\\/\\/totp\\/.*"
          }
        },
        "required": ["totpURI"],
        "additionalProperties": false
      },
      "MfaChallengeResponse": {
        "type": "object",
        "properties": {
          "twoFactorRedirect": {
            "type": "boolean",
            "enum": [true]
          }
        },
        "required": ["twoFactorRedirect"],
        "additionalProperties": false
      }
    }
  },
