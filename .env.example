# Somente desenvolvimento sintético. Não usar dados escolares reais.
DATABASE_URL=postgresql://soe:soe_local_only@127.0.0.1:54329/soe_dev
API_HOST=127.0.0.1
API_PORT=43121
LOG_LEVEL=info
NODE_ENV=development

# Local HTTP only. Production requires HTTPS and an independently generated secret.
AUTH_ORIGIN=http://127.0.0.1:43120
AUTH_SECRET=synthetic-development-secret-change-before-production
AUTH_RATE_WINDOW=60
AUTH_RATE_MAX=5

# Opcional: dispensa MFA somente em development com API, origem e banco locais.
# Deixe false para testar o fluxo real; true é rejeitado em test/production.
DEV_MFA_BYPASS=false

# Caixa local do Mailpit: pnpm mailpit; interface em http://127.0.0.1:43124
INVITATION_MAIL_MODE=development-smtp
INVITATION_SMTP_HOST=127.0.0.1
INVITATION_SMTP_PORT=43125
