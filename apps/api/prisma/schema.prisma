generator client {
  provider = "prisma-client"
  output   = "../src/infrastructure/database/generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// System-level synthetic fixture; no school or personal data is permitted.
model EnvironmentProbe {
  id String @id
  sample String
  @@map("environment_probe")
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  twoFactorEnabled Boolean @default(false)
  twoFactors TwoFactor[]
  sessions      Session[]
  accounts      Account[]
  schoolMemberships SchoolMembership[]
  saasOperator SaasOperator?
  initialSchools Organization[]

  @@unique([email])
  @@map("user")
}

// Platform authority never implies school membership or content access.
model SaasOperator {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  enabled Boolean @default(true)
  @@map("saas_operator")
}

model Organization {
  id String @id @default(uuid())
  name String
  timeZone String
  academicYear Int
  supportTeamLabel String
  studentLabel String
  classLabel String
  initialAdministratorId String
  initialAdministratorName String
  initialAdministrator User @relation(fields: [initialAdministratorId], references: [id], onDelete: Restrict)
  pilotStatus String @default("SYNTHETIC_ONLY")
  version Int @default(1)
  createdAt DateTime @default(now())
  memberships SchoolMembership[]
  audits SchoolAudit[]
  invitations SchoolInvitation[]
  @@map("organization")
}

model SchoolMembership {
  organizationId String
  userId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role String
  roles String[] @default(["SCHOOL_ADMIN"])
  version Int @default(1)
  active Boolean @default(true)
  @@id([organizationId, userId])
  @@index([userId, active])
  @@map("school_membership")
}

model SchoolInvitation {
  id String @id @default(uuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name String
  email String
  roles String[]
  isInitial Boolean @default(false)
  tokenHash String @unique
  tokenCiphertext String?
  revision Int @default(1)
  createdByUserId String
  createdAt DateTime @default(now())
  expiresAt DateTime
  acceptedAt DateTime?
  acceptedByUserId String?
  revokedAt DateTime?
  deliveryStatus String @default("QUEUED")
  deliveryAttempts Int @default(0)
  sentAt DateTime?
  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@map("school_invitation")
}

model InvitationRateLimit {
  key String @id
  count Int
  expiresAt DateTime
  @@map("invitation_rate_limit")
}

model SchoolAudit {
  id String @id @default(uuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorId String
  action String
  details Json
  occurredAt DateTime @default(now())
  @@index([organizationId, occurredAt])
  @@map("school_audit")
}

model TwoFactor {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret String
  backupCodes String
  verified Boolean @default(true)
  failedVerificationCount Int @default(0)
  lockedUntil DateTime?
  @@index([userId])
  @@index([secret])
  @@map("twoFactor")
}

model Session {
  mfaVerified Boolean @default(false)
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

// Global identity events, intentionally independent of school membership.
model AuthenticationAudit {
  id String @id @default(uuid())
  userId String
  action String
  occurredAt DateTime @default(now())
  @@index([userId, occurredAt])
  @@map("authentication_audit")
}
