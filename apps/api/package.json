{
  "name": "@soe/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.23",
    "@nestjs/common": "11.2.10",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "11.2.10",
    "@nestjs/platform-express": "11.2.10",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/throttler": "6.8.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@soe/contracts": "workspace:*",
    "@soe/email": "workspace:*",
    "better-auth": "1.7.23",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "nestjs-pino": "5.3.1",
    "nestjs-zod": "5.6.0",
    "nodemailer": "10.6.1",
    "pg": "8.23.1",
    "pg-boss": "12.38.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.10",
    "@soe/typescript-config": "workspace:*",
    "@testcontainers/postgresql": "12.2.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "prisma": "7.10.1",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "scripts": {
    "build": "nest build && node scripts/bundle.mjs && node scripts/generate-openapi.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "dev": "tsx watch --include \"src/**/*.ts\" --ignore \"dist/**\" --ignore \".build/**\" --ignore \"**/architecture-negative.ts\" scripts/start-development.mjs",
    "start": "node dist/main.js",
    "db:generate": "prisma generate --no-hints",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy"
  }
}
